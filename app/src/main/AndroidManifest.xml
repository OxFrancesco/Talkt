<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".TalktApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Talkt"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Talkt">

        <activity
            android:name="com.clerk.api.sso.SSOReceiverActivity"
            android:exported="false"
            android:theme="@style/Theme.Clerk.AuthBridge"
            tools:node="replace" />
        <activity
            android:name=".auth.ClerkCallbackActivity"
            android:exported="true"
            android:theme="@style/Theme.Clerk.AuthBridge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clerk" android:host="${applicationId}.callback" />
                <data android:scheme="clerk" android:host="${applicationId}.oauth" />
            </intent-filter>
        </activity>

        <activity
            android:name=".capture.CaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:theme="@style/Theme.Talkt.Capture" />

        <activity android:name=".cabinet.CloudCabinetActivity" android:exported="false" />

        <activity
            android:name=".cabinet.CabinetActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".trigger.TalktAccessibilityService"
            android:description="@string/accessibility_description"
            android:exported="true"
            android:label="Talkt text insertion"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <service
            android:name=".trigger.TalktVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
        </service>

        <service
            android:name=".trigger.TalktVoiceSessionService"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".trigger.TalktRecognitionService"
            android:exported="true"
            android:label="Talkt speech recognition"
            android:permission="android.permission.BIND_SPEECH_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <service
            android:name=".transcription.local.SherpaRecognitionService"
            android:exported="false"
            android:process=":local_asr" />

        <service
            android:name=".agent.AgentRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".capture.PendingTranscriptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".wakeword.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />
    </application>
</manifest>
